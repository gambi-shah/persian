\ProvidesFile{persian-xetex.def}
[2026/08/27 v0.1 XeTeX support for persian]


\makeatletter


% --------------------------------------------------------------------------
% Footnote rule
% --------------------------------------------------------------------------

\def\persian@footnoterule@rtl{%
    \kern-3\p@
    \hbox to \columnwidth{\hfill\rule{.4\columnwidth}{0.4\p@}}%
    \kern 2.6\p@
}
\let\footnoterule\persian@footnoterule@rtl

% --------------------------------------------------------------------------
% Math positioning compatibility such as array package
% --------------------------------------------------------------------------

\providecommand{\UseMathForPositioningText}{}

% ------------------------------------------
% Fix RTL natbib links for recent hyperref versions.
% ------------------------------------------

\IfHookExistsTF{cmd/hyper@natlinkstart/before}{

    \def\persian@hyper@natlinkstart#1{}
    \def\persian@hyper@natlinkend{}
    \def\persian@hyper@natlinkbreak#1#2{#1}

    \AddToHookWithArguments{cmd/persian@hyper@natlinkstart/before}
    {%
        \Hy@backout{#1}%
        \hyper@linkstart{cite}{cite.#1}%
        \def\hyper@nat@current{#1}%
    }
    \AddToHook{cmd/persian@hyper@natlinkend/after}
    {\hyper@linkend}
    \def\persian@hyper@natlinkbreak#1#2{%
        \hyper@linkend#1\hyper@linkstart{cite}{cite.#2}%
    }

    \def\NAT@hyper@#1{%
        \persian@hyper@natlinkstart{\@citeb\@extra@b@citeb}#1\persian@hyper@natlinkend
    }%

    \def\persian@patch@natlinkbreak{%
        \patchcmd{\NAT@citex}
        {\hyper@natlinkbreak}
        {\persian@hyper@natlinkbreak}
        {\persian@patch@natlinkbreak}
        {}%
    }
    \persian@patch@natlinkbreak
}{}


% ------------------------------------------------
% Disable fontspec math mode handling
% ------------------------------------------------
\ifnum\bbl@bidimode>\@ne
    \ExplSyntaxOn
    \bool_set_false:N \g__fontspec_math_bool
    \ExplSyntaxOff
\fi



\makeatother



\endinput
