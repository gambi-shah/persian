\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{persian}
[2026/09/02 v0.1.1 Persian support for pdfTeX, XeTeX, and LuaTeX]

\RequirePackage{iftex}
\RequirePackage{xparse}
\RequirePackage{xkeyval}

\makeatletter


% ------------------------------------------
% Package options
% ------------------------------------------

\define@key{persian}{bidi}{%
    \gdef\persian@bidi{#1}%
}

\define@key{persian}{layout}{%
    \edef\persian@layout{%
        \persian@layout\space#1%
    }%
}

\def\persian@layout{}

\ifPDFTeX
    \setkeys{persian}{bidi=default}
\fi

\ifXeTeX
    \setkeys{persian}{bidi=bidi-r}
\fi

\ifLuaTeX
    \setkeys{persian}{%
        bidi=basic,
        layout=counters tabular graphics footnotes
    }
\fi

\DeclareOptionX{bidi}{%
    \setkeys{persian}{bidi=#1}%
}

\DeclareOptionX{layout}{%
    \setkeys{persian}{layout=#1}%
}

\DeclareOptionX*{%
    \edef\persian@babeloptions{%
        \persian@babeloptions,\CurrentOption
    }%
}

\def\persian@babeloptions{}

\ProcessOptionsX\relax

% ------------------------------------------
% beamer conditionals
% ------------------------------------------

\newif\ifpersian@beamer
\newif\ifpersian@beamerrl
\@ifclassloaded{beamer}{\persian@beamertrue}{}
\@ifclassloaded{beamer-rl}{\persian@beamerrltrue}{}


% ------------------------------------------
% Resolve Bug of arabiccore Package
% ------------------------------------------

\@ifundefined{if@rl}{%
    \newif\if@rl
}{}

\ifPDFTeX
    \ifpersian@beamer
        \providecommand{\labelitemiv}
        {\if@rl\protect $-$ %
            \else\protect\textperiodcentred\fi}
        \providecommand{\labelitemi}
        {\if@rl\protect\textLR{$\bullet$}
            \else\protect\textbullet\fi}

        \providecommand{\labelitemii}
        {\if@rl\protect\textLR{$\circ$} %
            \else\protect\textLR{ \normalfont\bfseries\textendash}\fi}

        \providecommand{\labelitemiii}
        {\if@rl\protect\textLR{$*$} %
            \else\protect\textasteriskcentered\fi}

        \providecommand{\labelenumi}
        {\if@rl(\I{\number\c@enumi}).%
            \else{\number\c@enumi}.\fi}

        \providecommand{\labelenumii}
        {\if@rl\abjadnumeral{\number\c@enumii}. %
            \else({\number\c@enumii})\fi}

        \providecommand{\labelenumiii}
        {\if@rl\I{\number\c@enumiii}$\space-\space$ %
            \else({\number\c@enumiii})\fi}

        \providecommand{\labelenumiv}
        {\if@rl\abjadnumeral{\number\c@enumiv}$\space-\space$ %
            \else({\number\c@enumiv})\fi}
    \fi \fi

% ------------------------------------------
% Engine setup
% ------------------------------------------

\ifPDFTeX
    \RequirePackage[utf8]{inputenc}
    \RequirePackage[LAE,LFE,T1]{fontenc}
    \RequirePackage[bidi=\persian@bidi,\persian@babeloptions,english,farsi]{babel}
\fi

\ifXeTeX
    \RequirePackage[
        bidi=\persian@bidi,
        \persian@babeloptions
    ]{babel}

    \babelprovide[import,main]{persian}
    \babelprovide[import]{english}
\fi

\ifLuaTeX

    \RequirePackage{fontspec}

    \ifpersian@beamerrl

    \else
        \RequirePackage[
            bidi=\persian@bidi,
            layout=\persian@layout,
            \persian@babeloptions
        ]{babel}

    \fi

    \babelprovide[import,main,mapdigits]{persian}
    \babelprovide[import]{english}

\fi


