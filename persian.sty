\makeatletter

% ------------------------------------------------
% Label-safe sanitization of Babel bidi wrappers
% ------------------------------------------------

\long\def\persian@firstofone#1{#1}

\def\persian@strip@babel@bidi{%
    \@ifundefined{babelsublr}{}{%
        \let\babelsublr\persian@firstofone
    }%
    \@ifundefined{babelsubrl}{}{%
        \let\babelsubrl\persian@firstofone
    }%
}

\newif\ifpersian@label@patched

\def\persian@patch@label{%
    \ifpersian@label@patched
    \else
        \global\persian@label@patchedtrue
        \let\persian@orig@label\label
        \protected\def\label##1{%
            \begingroup
            \persian@strip@babel@bidi
            \edef\persian@tmp{##1}%
            \expandafter\endgroup
            \expandafter\persian@orig@label\expandafter{\persian@tmp}%
        }%
    \fi
}

\AddToHook{begindocument/end}{%
    \persian@patch@label
}



% ------------------------------------------
% Hyperref fallbacks
% ------------------------------------------

\AtBeginDocument{%
    \@ifpackageloaded{hyperref}{%
        \pdfstringdefDisableCommands{%
            \def\harfi#1{}%
            \def\adadi#1{}%
            \def\tartibi#1{}%
            \def\abjad#1{}%
            \def\Abjad#1{}%
            \def\@harfi#1{}%
            \def\@adadi#1{}%
            \def\@tartibi#1{}%
            \def\@abjad#1{}%
            \def\@Abjad#1{}%
            \def\lr#1{#1}%
            \def\rl#1{#1}%
            \def\LR#1{#1}%
            \def\RL#1{#1}%
        }%
    }{}%
}


% ------------------------------------------
% Bidi commands
% ------------------------------------------

\providecommand{\if@RTL}{\ifnum\bbl@thetextdir>\z@}
\providecommand{\@RTLtrue}{\chardef\bbl@thetextdir\@ne}
\providecommand{\@RTLfalse}{\chardef\bbl@thetextdir\z@}


\providecommand{\RLE}[1]{%
    \leavevmode
    {%
        \bbl@textdir{1}%
        #1%
    }%
}%

\providecommand{\LRE}[1]{%
    \leavevmode
    {%
        \bbl@textdir{0}%
        #1%
    }%
}%

\ProvideDocumentEnvironment{RTL}{}
{%
    \par
    \begingroup
    \bbl@pardir{1}%
    \bbl@textdir{1}%
}
{%
    \par
    \endgroup
}%


\ProvideDocumentEnvironment{LTR}{}
{%
    \par
    \begingroup
    \bbl@pardir{0}%
    \bbl@textdir{0}%
}
{%
    \par
    \endgroup
}%

\let\LR\LRE
\let\RL\RLE

% ------------------------------------------
% Inline language commands
% ------------------------------------------

\ProvideDocumentCommand{\lr}{m}{%
    \mbox{\unskip
        \@ifundefined{LatinAlphs}{}{\LatinAlphs}%
        \ifx\languagename\englishlanguage
            #1%
        \else
            \foreignlanguage[captions]{english}{#1}%
        \fi
    }\unskip
}

\ProvideDocumentCommand{\rl}{m}{%
    \mbox{\unskip
        \@ifundefined{PersianAlphs}{}{\PersianAlphs}%
        \ifx\languagename\persianmainlanguage
            #1%
        \else
            \foreignlanguage[captions]{\persianmainlanguage}{#1}%
        \fi
    }\unskip
}


% ------------------------------------------
% Language environments
% ------------------------------------------

\ProvideDocumentEnvironment{latin}{}%
{%
    \begin{LTR}
    \begin{otherlanguage*}[captions]{english}%
    \@ifundefined{LatinAlphs}{}{%
        \LatinAlphs
    }%
}%
{%
    \end{otherlanguage*}%
    \end{LTR}
}%

\ProvideDocumentEnvironment{persian}{}%
{%
    \begin{RTL}
    \begin{otherlanguage*}[captions]{\persianmainlanguage}%
    \@ifundefined{PersianAlphs}{}{%
        \PersianAlphs
    }%
}%
{%
    \end{otherlanguage*}%
    \end{RTL}
}%

% ------------------------------------------
% Latin font reset
% ------------------------------------------

\ProvideDocumentCommand{\resetlatinfont}{}{%
    \selectlanguage{english}%
}

% ------------------------------------------
% Date helpers
% ------------------------------------------

\DeclareRobustCommand{\latintoday}{%
    \foreignlanguage[date]{english}{\today}%
}






\makeatother


\endinput
